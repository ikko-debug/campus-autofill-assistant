{
  "manifest_version": 3,
  "name": "秋招本地填表助手",
  "version": "0.3.0",
  "description": "纯本地保存个人资料，辅助填写常见招聘表单，并匹配实习、工作与项目经历，不自动提交。",
  "permissions": ["storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "秋招本地填表助手",
    "default_popup": "popup.html"
  },
  "options_page": "options.html"
}
